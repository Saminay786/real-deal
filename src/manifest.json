{
  "manifest_version": 3,
  "name": "Real Deal",
  "version": "0.1.0",
  "description": "How much to trust amazon.in reviews: rating ranges and review themes over time. Runs entirely in your browser.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.amazon.in/*"],
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Real Deal",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png"
    }
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ]
}
